<% identity = Rails.configuration.x.foundation %>
<% title "Copperkettle Roast — small-batch coffee, roasted to order" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">Small-batch coffee, roasted to order.</h1>
      <p>Five single-origin roasts from Yirgacheffe to Sumatra, roasted fresh every week and shipped the day after the drum cools. Whole bean, 250g bags, no warehouses, no months-old stock.</p>
      <div class="md-actions">
        <%= link_to "Shop the roasts", storefront_products_path, class: "md-button md-button--filled" %>
        <% if user_signed_in? %>
          <%= link_to "Your orders", storefront_orders_path, class: "md-button md-button--outlined" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="how-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">The short story</p>
    <h2 id="how-title" class="md-section__heading">Roasted when you order, not when we have a spare hour.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature">
        <div><h3>Fresh every week</h3><p>We roast to order in five-bag batches. Your coffee is bagged, dated, and shipped within a day of roasting.</p></div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <div><h3>Direct trade</h3><p>We buy from the same farms each season — Yirgacheffe, Nyeri, Huila, Antigua, Aceh — and pay well above commodity rates.</p></div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <div><h3>Whole bean, 250g</h3><p>Every roast is a single 250g bag of whole beans, with the roast date on the front. Grind it the morning you open it.</p></div>
      </article>
    </div>
  </div>
</section>

<section class="md-section" aria-labelledby="orders-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Guest or regular</p>
    <h2 id="orders-title" class="md-section__heading">Check out fast, keep your history.</h2>
    <p>Buy as a guest with just an email, or create an account to keep every order in one place. Either way, checkout runs through a secure payment flow and your receipt is always one click away.</p>
    <div class="md-actions">
      <% if user_signed_in? %>
        <%= link_to "View your orders", storefront_orders_path, class: "md-button md-button--filled" %>
      <% else %>
        <%= link_to "Create an account", new_user_registration_path, class: "md-button md-button--filled" %>
        <%= link_to "Shop as a guest", storefront_products_path, class: "md-button md-button--outlined" %>
      <% end %>
    </div>
  </div>
</section>
